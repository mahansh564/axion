{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axion.local/schemas/model-usage-metrics-response.json",
  "title": "ModelUsageMetricsResponse",
  "type": "object",
  "required": ["filters", "totals", "by_provider", "by_model", "by_operation"],
  "properties": {
    "filters": {
      "type": "object",
      "required": ["since_ms", "until_ms", "trace_id", "operation", "provider", "model_id"],
      "properties": {
        "since_ms": { "type": ["number", "null"] },
        "until_ms": { "type": ["number", "null"] },
        "trace_id": { "type": ["string", "null"] },
        "operation": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "totals": {
      "$ref": "#/definitions/usageTotals"
    },
    "by_provider": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/providerUsageTotals"
      }
    },
    "by_model": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/modelUsageTotals"
      }
    },
    "by_operation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/operationUsageTotals"
      }
    }
  },
  "definitions": {
