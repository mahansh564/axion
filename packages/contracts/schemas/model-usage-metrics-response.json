        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "estimated_cost_usd",
        "costed_call_count",
        "uncosted_call_count"
      ],
      "properties": {
        "call_count": { "type": "number" },
        "prompt_tokens": { "type": "number" },
        "completion_tokens": { "type": "number" },
        "total_tokens": { "type": "number" },
        "estimated_cost_usd": { "type": "number" },
        "costed_call_count": { "type": "number" },
        "uncosted_call_count": { "type": "number" }
      },
      "additionalProperties": false
    },
    "providerUsageTotals": {
      "type": "object",
      "required": [
        "provider",
        "call_count",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "estimated_cost_usd",
        "costed_call_count",
        "uncosted_call_count"
      ],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "call_count": { "type": "number" },
        "prompt_tokens": { "type": "number" },
        "completion_tokens": { "type": "number" },
        "total_tokens": { "type": "number" },
        "estimated_cost_usd": { "type": "number" },
        "costed_call_count": { "type": "number" },
        "uncosted_call_count": { "type": "number" }
      },
      "additionalProperties": false
    },
    "modelUsageTotals": {
      "type": "object",
      "required": [
        "provider",
        "model_id",
        "call_count",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "estimated_cost_usd",
        "costed_call_count",
        "uncosted_call_count"
      ],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "call_count": { "type": "number" },
        "prompt_tokens": { "type": "number" },
        "completion_tokens": { "type": "number" },
        "total_tokens": { "type": "number" },
        "estimated_cost_usd": { "type": "number" },
        "costed_call_count": { "type": "number" },
        "uncosted_call_count": { "type": "number" }
      },
      "additionalProperties": false
    },
    "operationUsageTotals": {
      "type": "object",
      "required": [
        "operation",
        "call_count",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "estimated_cost_usd",
        "costed_call_count",
        "uncosted_call_count"
      ],
      "properties": {
        "operation": { "type": "string" },
        "call_count": { "type": "number" },
        "prompt_tokens": { "type": "number" },
        "completion_tokens": { "type": "number" },
        "total_tokens": { "type": "number" },
        "estimated_cost_usd": { "type": "number" },
        "costed_call_count": { "type": "number" },
        "uncosted_call_count": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
