# API (apps/api)
API_PORT=3000
DATA_DIR=./data
DATABASE_URL=
# Optional: require Authorization: Bearer <key>
API_KEY=
# Web app URL used by API compatibility redirects for visualization routes
WEB_APP_URL=http://127.0.0.1:5173
# Python worker
PYTHON_WORKER_URL=http://127.0.0.1:8000
# Max multipart upload bytes (default in code if unset)
MAX_UPLOAD_BYTES=52428800
# Optional malware scanning guard for voice uploads (disabled by default)
MALWARE_SCAN_ENABLED=0
MALWARE_SCAN_BIN=clamscan
MALWARE_SCAN_TIMEOUT_MS=15000
# Audio retention policy (voice blobs): keep blobs for this many days; use cleanup endpoint to enforce
AUDIO_RETENTION_DAYS=30
# Admin key required for /privacy/audio-retention/run (route remains disabled when unset)
PRIVACY_ADMIN_API_KEY=
# Required non-placeholder secret for destructive retention cleanup requests
AUDIO_RETENTION_CONFIRM_TOKEN=
# Optional JSON map for token pricing overrides, keyed by "provider:model_id"
# Example: {"openai:gpt-4o-mini":{"prompt_per_1k_usd":0.00015,"completion_per_1k_usd":0.0006}}
MODEL_PRICE_OVERRIDES_JSON=
# Biometric research governance feature flag (default disabled)
BIOMETRIC_RESEARCH_ENABLED=0
# Web app (apps/web)
VITE_API_BASE_URL=http://127.0.0.1:3000

# Python worker (apps/python-worker)
WORKER_PORT=8000
# Set to 1 in CI/tests to skip faster-whisper model load
AXION_TRANSCRIBE_STUB=0
# Transcription provider: faster-whisper|stub
AXION_TRANSCRIBE_PROVIDER=faster-whisper
# LLM extraction provider: ollama|openai|stub
AXION_LLM_PROVIDER=ollama
# Ollama for extraction (optional); if unset, worker uses deterministic stub JSON
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# OpenAI-compatible extraction provider settings (used when AXION_LLM_PROVIDER=openai)
# OPENAI_API_KEY is required in openai mode.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
